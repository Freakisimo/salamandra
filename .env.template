# Vertex AI / GCP Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=yourprojectid
GOOGLE_CLOUD_LOCATION=us-central1

# Model Tier Configuration (Configurable & Deprecation-Resilient)
# TIER_LIGHT: Fast parsing and entity extraction
MODEL_TIER_LIGHT_PRIMARY=gemini-2.5-flash
MODEL_TIER_LIGHT_FALLBACKS=gemini-2.0-flash,gemini-1.5-flash

# TIER_BALANCED: Source audit and standard cross-search
MODEL_TIER_BALANCED_PRIMARY=gemini-2.5-flash
MODEL_TIER_BALANCED_FALLBACKS=gemini-2.0-flash,gemini-2.5-pro

# TIER_DEEP: OSINT investigation, bias deconstruction, truth orchestration
MODEL_TIER_DEEP_PRIMARY=gemini-2.5-flash
MODEL_TIER_DEEP_FALLBACKS=gemini-2.0-flash,gemini-2.5-pro

AUTO_FALLBACK_ON_DEPRECATION=true

# Local Microservice Ports (A2A Network)
ORCHESTRATOR_PORT=8000
FACT_EXTRACTOR_PORT=8001
CORROBORATOR_PORT=8002
SOURCE_ANALYST_PORT=8003
OSINT_ANALYST_PORT=8004
BIAS_ANALYST_PORT=8005
GOV_DIRECTORY_SCOUT_PORT=8006

# Storage & Immutable Audit Ledger
SALAMANDRA_DATA_DIR=data
SALAMANDRA_DB_NAME=salamandra_directory.db
SALAMANDRA_LEDGER_FILE=audit_ledger.jsonl
